# Copy to .env and edit.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aurelia
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Origin(s) of the frontend, comma separated. Only needed if the frontend is NOT served through the Vite proxy / this server.
CLIENT_ORIGIN=http://localhost:5173
# IANA time zone of the restaurant. Used for "today", booking cut-off and cancellation window.
RESTAURANT_TZ=America/New_York
# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@aurelia-demo.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_STAFF_PASSWORD=Staff@1234
SEED_CUSTOMER_PASSWORD=Demo@1234
